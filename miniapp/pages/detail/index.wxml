<view class="container" wx:if="{{item}}">
  <view class="card">
    <view class="title">{{item.title}}</view>
    <view class="muted">{{item.school_name || "未知院校"}} · {{item.published_at || "未知时间"}}</view>
    <view class="muted" style="margin-top: 8rpx;">分类：{{item.category}} ｜ 来源：{{item.source_type}}</view>
    <view class="muted" style="margin-top: 8rpx;" wx:if="{{item.major}}">专业：{{item.major}}</view>
    <view class="muted" style="margin-top: 8rpx;" wx:if="{{item.region}}">地区：{{item.region}}</view>
  </view>

  <view class="card" wx:if="{{item.summary}}">
    <view style="font-weight: 700; margin-bottom: 12rpx;">摘要</view>
    <view>{{item.summary}}</view>
  </view>

  <view class="card" wx:if="{{item.source_url}}">
    <view style="font-weight: 700; margin-bottom: 12rpx;">原文链接</view>
    <view class="muted">{{item.source_url}}</view>
    <button class="btn-plain" style="margin-top: 16rpx;" bindtap="copySourceUrl">复制链接</button>
  </view>
</view>

