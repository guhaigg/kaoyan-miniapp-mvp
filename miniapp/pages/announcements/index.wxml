<view class="container">
  <view class="card">
    <input placeholder="院校名称" value="{{schoolName}}" bindinput="onSchoolInput" />
    <input placeholder="关键词" value="{{keywords}}" bindinput="onKeywordsInput" style="margin-top: 16rpx;" />
    <checkbox-group bindchange="onRefreshChange" style="margin-top: 16rpx;">
      <label><checkbox value="yes" checked="{{refresh}}" />按需补抓</label>
    </checkbox-group>
    <button class="btn-primary" style="margin-top: 16rpx;" bindtap="runQuery" loading="{{loading}}">查询</button>
  </view>

  <block wx:for="{{items}}" wx:key="id">
    <view class="card" bindtap="openDetail" data-item="{{item}}">
      <view style="font-weight: 700;">{{item.title}}</view>
      <view class="muted" style="margin-top: 10rpx;">{{item.school_name || "未知院校"}} · {{item.published_at || "未知时间"}}</view>
      <view class="muted" style="margin-top: 8rpx;">来源：{{item.source_type}}</view>
    </view>
  </block>
</view>

