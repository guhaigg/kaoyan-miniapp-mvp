<view class="container">
  <view class="card">
    <view class="title">{{title}}</view>
    <view class="muted">{{message}}</view>
    <button class="btn-primary" style="margin-top: 24rpx;" bindtap="handlePrimaryAction">{{primaryActionText}}</button>
    <button class="btn-plain" style="margin-top: 16rpx;" bindtap="goHome" wx:if="{{showHomeShortcut}}">返回首页</button>
  </view>
</view>
