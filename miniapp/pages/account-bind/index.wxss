input {
  background: #f3f6fb;
  border-radius: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
}

.card + .card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.helper-text {
  color: #6b7785;
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.detail-label {
  color: #6b7785;
}

.detail-value {
  color: #1f2d3d;
  text-align: right;
}

.mono {
  font-family: Menlo, Monaco, monospace;
  font-size: 22rpx;
}

.message {
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.message.success {
  background: #e8f7ee;
  color: #166534;
}

.message.error {
  background: #fff1f2;
  color: #b42318;
}
