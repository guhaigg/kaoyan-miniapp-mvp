{
  "name": "gewu-jianlu",
  "version": "1.0.0",
  "description": "格物简录是一个微信小程序 + FastAPI 后端项目。仓库中的公开链接已替换为占位符。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "lint:commit": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "test:backend": "python -m pytest -q backend/tests",
    "dev:backend": "./.venv/bin/python -m uvicorn --app-dir backend app.main:app --reload --host 0.0.0.0 --port 8000",
    "worker:crawler-v2": "PYTHONPATH=backend ./.venv/bin/python -m app.workers.crawler_v2_worker"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-org>/<your-repo>.git"
  },
  "bugs": {
    "url": "https://github.com/<your-org>/<your-repo>/issues"
  },
  "homepage": "https://github.com/<your-org>/<your-repo>",
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "husky": "^9.1.7"
  }
}
