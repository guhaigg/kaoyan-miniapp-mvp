APP_NAME=gewu-jianlu-backend
APP_ENV=dev
API_PREFIX=/api/v1
SECRET_KEY=replace-with-strong-secret
VISITOR_TOKEN_TTL_SECONDS=604800
DATABASE_URL=mysql+pymysql://<db-user>:<db-password>@db.example.internal:3306/app_db?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
WECHAT_APPID=
WECHAT_SECRET=
USE_MOCK_WECHAT=true
ADMIN_TOKEN=replace-admin-token
RATE_LIMIT_PER_MINUTE=120
ENABLE_NOTIFICATION_WORKER=true
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_POLL_INTERVAL_SECONDS=1
NOTIFICATION_CACHE_REFRESH_SECONDS=60
NOTIFICATION_BATCH_WINDOW_SECONDS=180
NOTIFICATION_INAPP_DELAY_SECONDS=0
NOTIFICATION_RETRY_DELAY_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=120
NOTIFICATION_SSE_POLL_SECONDS=1
ENABLE_SITE_SECTION_BROWSER_PROBE=false
SITE_SECTION_BROWSER_PROBE_TIMEOUT_SECONDS=8
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://example.com,https://www.example.com
