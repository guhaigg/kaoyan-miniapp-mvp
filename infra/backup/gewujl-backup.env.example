APP_NAME=gewujl
BACKUP_ROOT=/root/backups
DEPLOY_PATH=/root/code/kaoyan-miniapp-mvp
WEB_ROOT=/var/www/html
ENV_FILE=/root/code/kaoyan-miniapp-mvp/backend/.env

# Retention (days)
KEEP_DAYS_DAILY=14
KEEP_DAYS_PREDEPLOY=10

# Optional: upload to object storage through rclone
# Example: RCLONE_REMOTE=tencent-cos:gewujl-backup
RCLONE_REMOTE=

# Optional: upload to another Tencent Cloud server by SSH
# Format: user@host:/absolute/path
REMOTE_BACKUP_TARGET=
REMOTE_SSH_PORT=22
# Example: /root/.ssh/id_ed25519
REMOTE_SSH_KEY=
