[Unit]
Description=Ge Wu Jian Lu FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/kaoyan-miniapp-mvp/backend
EnvironmentFile=/srv/kaoyan-miniapp-mvp/backend/.env
ExecStart=/srv/kaoyan-miniapp-mvp/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --timeout-keep-alive 5 --timeout-graceful-shutdown 5
Restart=always
RestartSec=3
TimeoutStopSec=6
KillMode=mixed
SendSIGKILL=yes
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
