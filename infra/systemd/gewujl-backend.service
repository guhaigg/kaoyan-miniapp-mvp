[Unit]
Description=Ge Wu Jian Lu FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gewujl/backend
EnvironmentFile=/home/ubuntu/gewujl/backend/.env
ExecStart=/home/ubuntu/gewujl/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --timeout-keep-alive 5 --timeout-graceful-shutdown 5
Restart=always
RestartSec=3
TimeoutStopSec=6
KillMode=mixed
SendSIGKILL=yes
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
